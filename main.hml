/* برچسب Open */
    .status-badge {
      align-self: flex-start;
      background: rgba(20, 32, 25, 0.7);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #f4efe8;
      padding: 6px 18px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    /* ردیف دکمه‌های آیکونی */
    .action-icons-row {
      width: 100%;
      display: flex;
      justify-content: space-between;
      gap: 8px;
    }

    .action-btn {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(30, 45, 36, 0.65);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(244, 239, 232, 0.25);
      color: #f4efe8;
      display: flex;
      justify-content: center;
      align-items: center;
      text-decoration: none;
      font-size: 1.15rem;
      transition: 0.3s;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }

    .action-btn:hover {
      background: #528362;
      transform: translateY(-2px);
    }

    /* دکمه مشاهده منو */
    .view-menu-btn {
      width: 100%;
      padding: 14px;
      background: #8cb6d8;
      color: #1a2c20;
      text-align: center;
      text-decoration: none;
      border-radius: 14px;
      font-size: 1.1rem;
      font-weight: 700;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
      transition: 0.3s;
      border: none;
      display: block;
    }

    .view-menu-btn:hover {
      background: #a3c9e8;
    }
  </style>
</head>
<body>

  <!-- عکس‌های پس‌زمینه که اسلاید می‌شوند -->
  <div class="slider-bg">
    <div class="slide active" style="background-image: url('slide1.jpg');"></div>
    <div class="slide" style="background-image: url('slide2.jpg');"></div>
    <div class="slide" style="background-image: url('slide3.jpg');"></div>
    <div class="slide" style="background-image: url('slide4.jpg');"></div>
  </div>

  <div class="dark-overlay"></div>

  <!-- نوار بالا -->
  <div class="top-bar">
    <a href="index.html" class="nav-btn" title="بازگشت"><i class="fa-solid fa-chevron-right"></i></a>
    <div class="nav-btn" title="منو"><i class="fa-solid fa-bars"></i></div>
  </div>

  <!-- کارت شیشه‌ای وسط صفحه -->
  <div class="info-card">
    <div class="logo-container">
      <img src="logo.png" alt="لوگو هتل رستوران واحه">
    </div>
    <h1 class="title-fa">هتل رستوران واحه</h1>
    <h2 class="title-en">Vaahe Hotel Restaurant</h2>
    <p class="story-text">
      واحه یعنی جایی در میان ریگستان، جایی زاده‌ی عشق و صبوری و رویایی که رها نشد...
    </p>
  </div>

  <!-- بخش پایین صفحه -->
  <div class="bottom-section">
    <div class="status-badge">Open</div>

    <!-- دکمه‌های آیکونی -->
    <div class="action-icons-row">
      <a href="#" class="action-btn" title="اشتراک‌گذاری"><i class="fa-solid fa-share-nodes"></i></a>
      <a href="#" class="action-btn" title="ساعت کاری"><i class="fa-regular fa-clock"></i></a>
      <a href="https://instagram.com/vaahe_cafe_hotel" target="_blank" class="action-btn" title="اینستاگرام"><i class="fa-brands fa-instagram"></i></a>
      <a href="https://maps.google.com" target="_blank" class="action-btn" title="مسیریابی"><i class="fa-solid fa-location-dot"></i></a>
      <a href="tel:09120000000" class="action-btn" title="تماس تلفنی"><i class="fa-solid fa-phone"></i></a>
    </div>

    <!-- دکمه بزرگ مشاهده منو -->
    <a href="#" class="view-menu-btn">مشاهده منو</a>
  </div>

  <!-- اسکریپت تعویض خودکار تصاویر با مکث -->
  <script>
    const slides = document.querySelectorAll('.slide');
    let currentSlide = 0;
    const slideInterval = 4000; // هر ۴ ثانیه یکبار عکس عوض می‌شود

    function nextSlide() {
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
    }

    setInterval(nextSlide, slideInterval);
  </script>

</body>
</html>
 